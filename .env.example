# Telegram Bot API
TELEGRAM_BOT_TOKEN=<paste-from-@BotFather>
TELEGRAM_TEST_CHANNEL_ID=<channel-id-or-@username>

# GitHub
GITHUB_TOKEN=<paste-from-https://github.com/settings/tokens>

# Database (iter-28+)
DATABASE_URL=postgresql+asyncpg://localhost/telegram_tech_publisher

# Anthropic API (iter-29a+): optional in dev. Required only for the 29b
# real_llm smoke and at runtime when the bot wires AnthropicLLMDrafterClient.
# Paid OPEX; lives in `.env.local` (gitignored) for production-like setups.
ANTHROPIC_API_KEY=

# Logging
LOG_LEVEL=INFO
