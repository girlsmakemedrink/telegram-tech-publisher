# Telegram Bot API
TELEGRAM_BOT_TOKEN=<paste-from-@BotFather>
TELEGRAM_CHANNEL_ID=<channel-id-or-@username-for-the-daemon-target>
TELEGRAM_TEST_CHANNEL_ID=<channel-id-or-@username-for-smoke-tests>

# GitHub
GITHUB_TOKEN=<paste-from-https://github.com/settings/tokens>

# Anthropic (required for the autonomous loop; loop commands fail-fast if unset)
ANTHROPIC_API_KEY=<paste-from-https://console.anthropic.com>

# Loop runtime
LOOP_CONFIG_PATH=config/loop.toml
STATE_DIR=~/.local/share/telegram-tech-publisher

# Database (iter-30+ multi-tenant path; unused by the autonomous loop)
DATABASE_URL=postgresql+asyncpg://localhost/telegram_tech_publisher

# Logging
LOG_LEVEL=INFO
